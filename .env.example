# Copy this file to .env and fill in what you need. Nothing here is
# required to run the app — every feature that reads one of these
# variables degrades gracefully (logged, not thrown) if it's missing.

# JWT signing secret. render.yaml generates one automatically on Render;
# set your own for local dev if you want stable tokens across restarts.
JWT_SECRET=change-me-to-a-long-random-string

# --- Webcam proctoring alert emails (optional) ---
# Sign up free at https://resend.com, verify a sending identity (or use
# their default onboarding@resend.dev sender for testing), and create an
# API key. Without these two set, webcam alerts still show up live on the
# instructor dashboard -- you only lose the email notification.
RESEND_API_KEY=
ALERT_TO_EMAIL=instructor@example.edu
ALERT_FROM_EMAIL=Mastery Pulse <onboarding@resend.dev>
